# Application
APP_NAME=Quanta
ENVIRONMENT=development
LOG_LEVEL=INFO

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# UI Pay Backend
UIPAY_BASE_URL=http://localhost:8001
UIPAY_SERVICE_TOKEN=

# Provider selection
LLM_PROVIDER=groq
ASR_PROVIDER=naijavox
OCR_PROVIDER=paddleocr
TTS_PROVIDER=edge

# ASR Subsystem Configuration
ASR_MAX_AUDIO_BYTES=10000000
ASR_MAX_DURATION_SECONDS=60.0

# ASR Provider: NaijaVox-2.0
ASR_NAIJAVOX_MODEL_ID=Axiveri/NaijaVox-2.0
ASR_NAIJAVOX_DEVICE=auto

# ASR Provider: faster-whisper
ASR_FASTER_WHISPER_MODEL=large-v3
ASR_FASTER_WHISPER_DEVICE=auto
ASR_FASTER_WHISPER_COMPUTE_TYPE=auto

# ---------------------------------------------------------------------------
# OCR Subsystem Configuration
# No external API key required — PaddleOCR runs local inference.
# ---------------------------------------------------------------------------

# OCR provider: only "paddleocr" is currently supported.
OCR_PROVIDER=paddleocr

# Maximum raw image payload size in bytes (default: 20 MB).
OCR_MAX_IMAGE_BYTES=20000000

# Maximum pixel count (width × height) for decompression-bomb protection (default: 50 MP).
OCR_MAX_IMAGE_PIXELS=50000000

# PaddleOCR device: "auto" (GPU if available, else CPU), "cpu", or "gpu".
# For most developer machines use "auto" or "cpu".
OCR_PADDLE_DEVICE=auto