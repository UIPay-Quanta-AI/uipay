# Application
APP_NAME=Quanta
ENVIRONMENT=development
LOG_LEVEL=INFO

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# UI Pay Backend
UIPAY_BASE_URL=http://localhost:8001
UIPAY_SERVICE_TOKEN=

# Provider selection
LLM_PROVIDER=groq
ASR_PROVIDER=naijavox
OCR_PROVIDER=paddleocr
TTS_PROVIDER=edge

# ASR Subsystem Configuration
ASR_MAX_AUDIO_BYTES=10000000
ASR_MAX_DURATION_SECONDS=60.0

# ASR Provider: NaijaVox-2.0
ASR_NAIJAVOX_MODEL_ID=Axiveri/NaijaVox-2.0
ASR_NAIJAVOX_DEVICE=auto

# ASR Provider: faster-whisper
ASR_FASTER_WHISPER_MODEL=large-v3
ASR_FASTER_WHISPER_DEVICE=auto
ASR_FASTER_WHISPER_COMPUTE_TYPE=auto