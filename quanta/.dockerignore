venv/
env/
.git/
.env
.env.*
!.env.example

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyrefly/

tests/
docs/
scripts/
output_audio/

*.log
logs/
tmp/
temp/

.vscode/
.idea/
.DS_Store
