generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  middleName   String?   @map("middle_name")
  dob          String    @map("date_of_birth")
  phoneNumber  String    @map("phone_number")
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt() @map("updated_at")
  sessions     Session[]

  wallets              Wallet[]
  beneficiaries        Beneficiary[]
  sentTransactions     Transaction[]  @relation("TransactionSender")
  receivedTransactions Transaction[]  @relation("TransactionRecipient")
  merchants            Merchant[]
  voiceProfile         VoiceProfile?

  @@map("users")
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// this na where person money dey sit. maybe one wallet per currency later, just one for now
model Wallet {
  id       String  @id @default(uuid())
  userId   String  @map("user_id")
  balance  Decimal @default(0) @db.Decimal(18, 2)
  currency String  @default("NGN")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallets")
}

// people wey you don send money before, so you no go dey type their acct number every time
model Beneficiary {
  id            String @id @default(uuid())
  userId        String @map("user_id")
  nickname      String
  accountNumber String @map("account_number")
  bankName      String @map("bank_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("beneficiaries")
}

model Transaction {
  id          String  @id @default(uuid())
  senderId    String  @map("sender_id")
  recipientId String  @map("recipient_id")
  amount      Decimal @db.Decimal(18, 2)
  method      String
  reference   String  @unique
  status      String  @default("pending")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sender    User @relation("TransactionSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("TransactionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@map("transactions")
}

model Merchant {
  id           String  @id @default(uuid())
  userId       String  @map("user_id")
  businessName String  @map("business_name")
  qrCodeUrl    String  @map("qr_code_url")
  category     String
  approved     Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nfcTags NfcTag[]

  @@index([userId])
  @@map("merchants")
}

// id no be random uuid, na the real serial number wey dey on the physical tag
model NfcTag {
  id         String  @id
  merchantId String  @map("merchant_id")
  active     Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("nfc_tags")
}

// just one voice profile per user for now, encryptedBlob na the encrypted voiceprint
model VoiceProfile {
  id            String @id @default(uuid())
  userId        String @unique @map("user_id")
  encryptedBlob Bytes  @map("encrypted_blob")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("voice_profiles")
}
