generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  middleName         String?   @map("middle_name")
  dob                String    @map("date_of_birth")
  phoneNumber        String    @map("phone_number")
  passwordHash       String    @map("password_hash")
  // "user" or "admin", only admins can access the admin endpoints
  role               String    @default("user")
  // "active" or "suspended", set by an admin - a suspended user keeps their
  // data but is blocked from signing in (see JwtAuthGuard/local strategy)
  status             String    @default("active")
  // "nin" or "bvn", set once the user verifies an ID during profile setup
  idType             String?   @map("id_type")
  idNumber           String?   @map("id_number")
  identityVerifiedAt DateTime? @map("identity_verified_at")
  // hashed 4-digit PIN required to authorize a transfer, separate from the login password
  transactionPinHash String?   @map("transaction_pin_hash")
  // which notification categories this user wants - no delivery system
  // exists yet (no push/SMS/email sender), so these are real, saved
  // preferences with nothing to gate just yet
  notifyGeneral            Boolean  @default(true) @map("notify_general")
  notifySmsAlerts          Boolean  @default(true) @map("notify_sms_alerts")
  notifyCardTransactions   Boolean  @default(true) @map("notify_card_transactions")
  notifyTransfers          Boolean  @default(true) @map("notify_transfers")
  notifyOthers             Boolean  @default(true) @map("notify_others")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt() @map("updated_at")
  sessions           Session[]

  wallets              Wallet[]
  beneficiaries        Beneficiary[]
  sentTransactions     Transaction[]  @relation("TransactionSender")
  receivedTransactions Transaction[]  @relation("TransactionRecipient")
  merchants            Merchant[]
  voiceProfile         VoiceProfile?
  supportMessages      SupportMessage[]
  walletFundings       WalletFunding[]
  financialProfile     FinancialProfile?
  goals                Goal[]
  budgets              Budget[]

  @@map("users")
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  // captured at sign-in/sign-up time from the request, purely for display
  // on the Active Device List - not used for anything security-sensitive
  userAgent        String?
  ipAddress        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// "Chat with us" / "Report Issue" messages from the Support screen - just
// persisted for now, no admin viewer or live chat wired up yet
model SupportMessage {
  id      String @id @default(uuid())
  userId  String @map("user_id")
  // "chat" or "issue"
  type    String
  message String

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("support_messages")
}

// holds a user's spendable balance. one wallet per user for now, may support multiple currencies later
model Wallet {
  id            String  @id @default(uuid())
  userId        String  @map("user_id")
  balance       Decimal @default(0) @db.Decimal(18, 2)
  currency      String  @default("NGN")
  // stable, looked-up-by number - not derived on the fly, so a sender can
  // resolve a recipient's name from it before paying
  accountNumber String  @unique @map("account_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallets")
}

// one row per attempt to fund a wallet via Paystack. Created "pending" when
// the user starts a payment, flipped to "success"/"failed" once we get a
// confirmed result (webhook and the client-side verify call race for this;
// only one of them actually credits the wallet, see WalletService)
model WalletFunding {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  reference String  @unique
  amount    Decimal @db.Decimal(18, 2)
  status    String  @default("pending")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallet_fundings")
}

// saved transfer recipients, so users don't have to retype account details every time
model Beneficiary {
  id            String @id @default(uuid())
  userId        String @map("user_id")
  nickname      String
  accountNumber String @map("account_number")
  bankName      String @map("bank_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("beneficiaries")
}

model Transaction {
  id          String  @id @default(uuid())
  senderId    String  @map("sender_id")
  recipientId String  @map("recipient_id")
  amount      Decimal @db.Decimal(18, 2)
  method      String
  reference   String  @unique
  status      String  @default("pending")
  // set by an admin reviewing a transaction, e.g. for a suspected mismatch
  // or malicious activity - purely a review marker, it does not affect
  // whether the transaction already happened
  flagged     Boolean @default(false)
  flagReason  String? @map("flag_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sender    User @relation("TransactionSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("TransactionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@map("transactions")
}

model Merchant {
  id            String  @id @default(uuid())
  userId        String  @map("user_id")
  // individual or organisation, decides what KYC documents get requested later
  applicantType String  @default("individual") @map("applicant_type")
  businessName  String  @map("business_name")
  // empty until the QR/NFC module generates one for this merchant
  qrCodeUrl     String? @map("qr_code_url")
  category      String
  // "pending", "approved", or "rejected", set by an admin reviewing the application
  status        String  @default("pending")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nfcTags NfcTag[]

  @@index([userId])
  @@map("merchants")
}

// id is not a generated uuid, it's the physical tag's own serial number
model NfcTag {
  id         String  @id
  merchantId String  @map("merchant_id")
  active     Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("nfc_tags")
}

// one voice profile per user for now. encryptedBlob stores the encrypted voiceprint
model VoiceProfile {
  id            String @id @default(uuid())
  userId        String @unique @map("user_id")
  encryptedBlob Bytes  @map("encrypted_blob")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("voice_profiles")
}

// Quanta's authoritative planning input for budget generation - one per
// user. Created on first write from Quanta (get-or-initialize semantics,
// see QuantaFinancialProfileService).
model FinancialProfile {
  id               String  @id @default(uuid())
  userId           String  @unique @map("user_id")
  monthlyIncome    Decimal @default(0) @db.Decimal(18, 2) @map("monthly_income")
  // "monthly" | "biweekly" | "weekly" | "irregular"
  incomeFrequency  String  @default("monthly") @map("income_frequency")
  // "salaried" | "self_employed" | "freelance" | "unemployed" | "other"
  employmentType   String  @default("salaried") @map("employment_type")
  fixedExpenses    Decimal @default(0) @db.Decimal(18, 2) @map("fixed_expenses")
  variableExpenses Decimal @default(0) @db.Decimal(18, 2) @map("variable_expenses")
  savingsTarget    Decimal @default(0) @db.Decimal(18, 2) @map("savings_target")
  currency         String  @default("NGN")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("financial_profiles")
}

// A savings target Quanta tracks for a user. Tracking/planning only - never
// moves money itself (see docs/uipay-client-contract.md in quanta/).
model Goal {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  name          String
  targetAmount  Decimal   @db.Decimal(18, 2) @map("target_amount")
  currentAmount Decimal   @default(0) @db.Decimal(18, 2) @map("current_amount")
  targetDate    DateTime? @map("target_date") @db.Date
  currency      String    @default("NGN")
  // "active" | "completed" | "paused" | "cancelled"
  status        String    @default("active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals")
}

// Versioned budget for a period. Updating a budget never mutates a row -
// it creates a new row with version+1 for the SAME start/end date and
// marks the previous one "superseded" (see quanta/docs/BUDGET.md).
// Nested structures (income sources, category allocations, goal
// allocations) are stored as JSON since Quanta owns their shape and they
// are never queried by field - only round-tripped whole.
model Budget {
  id                     String   @id @default(uuid())
  userId                 String   @map("user_id")
  startDate              DateTime @map("start_date") @db.Date
  endDate                DateTime @map("end_date") @db.Date
  currency               String   @default("NGN")
  version                Int      @default(1)
  // "active" | "superseded" | "cancelled" | "expired"
  status                 String   @default("active")
  // { expected_income: string, income_sources: string[] }
  incomePlan             Json     @map("income_plan")
  // [{ category, allocated_amount, notes }]
  allocations            Json
  // [{ goal_id, goal_name, allocated_amount }]
  goalAllocations        Json     @map("goal_allocations")
  totalAllocatedExpenses Decimal  @db.Decimal(18, 2) @map("total_allocated_expenses")
  totalAllocatedGoals    Decimal  @db.Decimal(18, 2) @map("total_allocated_goals")
  totalUnallocatedIncome Decimal  @db.Decimal(18, 2) @map("total_unallocated_income")
  previousVersionId      String?  @map("previous_version_id")
  // "initial_generation" | "income_change" | "expense_change" | "goal_change" | "user_rebalance" | "financial_change" | "other"
  updateReason           String   @default("initial_generation") @map("update_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("budgets")
}
