generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  middleName         String?   @map("middle_name")
  dob                String    @map("date_of_birth")
  phoneNumber        String    @map("phone_number")
  passwordHash       String    @map("password_hash")
  // "user" or "admin", only admins can access the admin endpoints
  role               String    @default("user")
  // "active" or "suspended", set by an admin - a suspended user keeps their
  // data but is blocked from signing in (see JwtAuthGuard/local strategy)
  status             String    @default("active")
  // "nin" or "bvn", set once the user verifies an ID during profile setup
  idType             String?   @map("id_type")
  idNumber           String?   @map("id_number")
  identityVerifiedAt DateTime? @map("identity_verified_at")
  // hashed 4-digit PIN required to authorize a transfer, separate from the login password
  transactionPinHash String?   @map("transaction_pin_hash")
  // which notification categories this user wants - no delivery system
  // exists yet (no push/SMS/email sender), so these are real, saved
  // preferences with nothing to gate just yet
  notifyGeneral            Boolean  @default(true) @map("notify_general")
  notifySmsAlerts          Boolean  @default(true) @map("notify_sms_alerts")
  notifyCardTransactions   Boolean  @default(true) @map("notify_card_transactions")
  notifyTransfers          Boolean  @default(true) @map("notify_transfers")
  notifyOthers             Boolean  @default(true) @map("notify_others")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt() @map("updated_at")
  sessions           Session[]

  wallets              Wallet[]
  beneficiaries        Beneficiary[]
  sentTransactions     Transaction[]  @relation("TransactionSender")
  receivedTransactions Transaction[]  @relation("TransactionRecipient")
  merchants            Merchant[]
  voiceProfile         VoiceProfile?
  supportMessages      SupportMessage[]
  walletFundings       WalletFunding[]

  @@map("users")
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  // captured at sign-in/sign-up time from the request, purely for display
  // on the Active Device List - not used for anything security-sensitive
  userAgent        String?
  ipAddress        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// "Chat with us" / "Report Issue" messages from the Support screen - just
// persisted for now, no admin viewer or live chat wired up yet
model SupportMessage {
  id      String @id @default(uuid())
  userId  String @map("user_id")
  // "chat" or "issue"
  type    String
  message String

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("support_messages")
}

// holds a user's spendable balance. one wallet per user for now, may support multiple currencies later
model Wallet {
  id            String  @id @default(uuid())
  userId        String  @map("user_id")
  balance       Decimal @default(0) @db.Decimal(18, 2)
  currency      String  @default("NGN")
  // stable, looked-up-by number - not derived on the fly, so a sender can
  // resolve a recipient's name from it before paying
  accountNumber String  @unique @map("account_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallets")
}

// one row per attempt to fund a wallet via Paystack. Created "pending" when
// the user starts a payment, flipped to "success"/"failed" once we get a
// confirmed result (webhook and the client-side verify call race for this;
// only one of them actually credits the wallet, see WalletService)
model WalletFunding {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  reference String  @unique
  amount    Decimal @db.Decimal(18, 2)
  status    String  @default("pending")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallet_fundings")
}

// saved transfer recipients, so users don't have to retype account details every time
model Beneficiary {
  id            String @id @default(uuid())
  userId        String @map("user_id")
  nickname      String
  accountNumber String @map("account_number")
  bankName      String @map("bank_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("beneficiaries")
}

model Transaction {
  id          String  @id @default(uuid())
  senderId    String  @map("sender_id")
  recipientId String  @map("recipient_id")
  amount      Decimal @db.Decimal(18, 2)
  method      String
  reference   String  @unique
  status      String  @default("pending")
  // set by an admin reviewing a transaction, e.g. for a suspected mismatch
  // or malicious activity - purely a review marker, it does not affect
  // whether the transaction already happened
  flagged     Boolean @default(false)
  flagReason  String? @map("flag_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sender    User @relation("TransactionSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("TransactionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@map("transactions")
}

model Merchant {
  id            String  @id @default(uuid())
  userId        String  @map("user_id")
  // individual or organisation, decides what KYC documents get requested later
  applicantType String  @default("individual") @map("applicant_type")
  businessName  String  @map("business_name")
  // empty until the QR/NFC module generates one for this merchant
  qrCodeUrl     String? @map("qr_code_url")
  category      String
  // "pending", "approved", or "rejected", set by an admin reviewing the application
  status        String  @default("pending")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nfcTags NfcTag[]

  @@index([userId])
  @@map("merchants")
}

// id is not a generated uuid, it's the physical tag's own serial number
model NfcTag {
  id         String  @id
  merchantId String  @map("merchant_id")
  active     Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("nfc_tags")
}

// one voice profile per user for now. encryptedBlob stores the encrypted voiceprint
model VoiceProfile {
  id            String @id @default(uuid())
  userId        String @unique @map("user_id")
  encryptedBlob Bytes  @map("encrypted_blob")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("voice_profiles")
}
